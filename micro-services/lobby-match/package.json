{
  "name": "lobby-match",
  "version": "0.2.3",
  "description": "Lobby and match bounded context",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest --passWithNoTests --coverage",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "lint": "biome check src/",
    "format": "biome check --write src/"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.0",
    "jest": "^30.0.0",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "jest": {
    "coverageReporters": [
      "lcov",
      "text-summary"
    ]
  }
}
