{
  "name": "deck-workshop",
  "version": "0.2.3",
  "description": "Deck workshop bounded context",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest --passWithNoTests --coverage",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "lint": "biome check src/",
    "format": "biome check --write src/"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.0"
  },
  "jest": {
    "coverageReporters": [
      "lcov",
      "text-summary"
    ]
  }
}
