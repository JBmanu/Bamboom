{
  "name": "bamboom-monorepo",
  "version": "0.0.1",
  "private": true,
  "description": "Bamboom monorepo — root package for git hooks and commit linting only",
  "scripts": {
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.3.0"
  },
  "lint-staged": {
    "api-gateway/src/**/*.ts": [
      "bash -c 'cd api-gateway && npm run lint'"
    ],
    "micro-services/player-identity/src/**/*.ts": [
      "bash -c 'cd micro-services/player-identity && npm run lint'"
    ],
    "micro-services/lobby-match/src/**/*.ts": [
      "bash -c 'cd micro-services/lobby-match && npm run lint'"
    ],
    "micro-services/deck-workshop/src/**/*.ts": [
      "bash -c 'cd micro-services/deck-workshop && npm run lint'"
    ],
    "micro-services/card-forge/src/**/*.ts": [
      "bash -c 'cd micro-services/card-forge && npm run lint'"
    ],
    "frontend/player/src/**/*.{ts,vue}": [
      "bash -c 'cd frontend/player && npm run lint'"
    ],
    "frontend/admin/src/**/*.{ts,vue}": [
      "bash -c 'cd frontend/admin && npm run lint'"
    ],
    "micro-services/progress/**/*.kt": [
      "bash -c 'cd micro-services/progress && ./gradlew lint'"
    ],
    "micro-services/progress/**/*.scala": [
      "bash -c 'cd micro-services/progress && ./gradlew lint'"
    ],
    "build-logic/**/*.kt": [
      "bash -c 'cd micro-services/progress && ./gradlew lint'"
    ]
  }
}