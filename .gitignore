build/
!src/**/build/
# Il wrapper JAR va committato (eccezione intenzionale):
# permette a chiunque cloni il repo di usare ./gradlew
# senza installare Gradle. È l'unico binario che si committa.
!gradle/wrapper/gradle-wrapper.jar


# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle-wrapper.jar

# Avoid ignore Gradle wrappper properties
!gradle-wrapper.properties

