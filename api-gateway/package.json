{
  "name": "api-gateway",
  "version": "0.1.5",
  "description": "Bamboom API Gateway — single entry point, routes to microservices",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest --passWithNoTests --coverage",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "lint": "biome check src/",
    "format": "biome check --write src/"
  },
  "dependencies": {
    "express": "^5.0.0",
    "http-proxy-middleware": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.1",
    "jest": "^30.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "jest": {
    "coverageReporters": [
      "lcov",
      "text-summary"
    ]
  }
}
