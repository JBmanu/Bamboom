{
  "name": "admin",
  "version": "0.1.0",
  "description": "Bamboom admin frontend (Vue 3 + Vite)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run --coverage",
    "type-check": "vue-tsc --noEmit",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "lint": "eslint . && prettier --check src/",
    "format": "eslint . --fix && prettier --write src/"
  },
  "dependencies": {
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^2.1.9",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.9",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.0"
  },
  "overrides": {
    "vite": "^6.0.5"
  }
}
