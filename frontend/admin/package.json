{
  "name": "admin",
  "version": "0.1.0",
  "description": "Bamboom admin frontend (Vue 3 + Vite)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run --coverage",
    "type-check": "vue-tsc --noEmit",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "lint": "eslint . && prettier --check src/",
    "format": "eslint . --fix && prettier --write src/"
  },
  "dependencies": {
  },
  "devDependencies": {
  }
}
