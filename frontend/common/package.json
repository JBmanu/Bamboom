{
  "name": "@bamboom/common",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vue-tsc -b",
    "test": "vitest run --coverage",
    "type-check": "vue-tsc --noEmit",
    "test:watch": "vitest",
    "clean": "rm -rf coverage node_modules/.tmp dist",
    "lint": "eslint . && prettier --check src/",
    "format": "eslint . --fix && prettier --write src/"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "peerDependencies": {
    "vue": "^3.5.13"
  }
}