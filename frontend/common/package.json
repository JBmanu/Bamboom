{
  "name": "@bamboom/common",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vue-tsc -b",
    "test": "vitest run --coverage",
    "type-check": "vue-tsc --noEmit",
    "test:watch": "vitest",
    "clean": "rm -rf coverage node_modules/.tmp dist",
    "lint": "eslint . && prettier --check src/",
    "format": "eslint . --fix && prettier --write src/"
  },
  "exports": {
    ".": "./src/index.ts",
    "./theme.css": "./src/style/theme.css"
  },
  "peerDependencies": {
    "pinia": "^4.0.3",
    "vue": "^3.5.13",
    "effect": "^4.0.4",
    "@vueuse/core": "^15.0.0"
  }
}
