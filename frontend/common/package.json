{
  "name": "@bamboom/common",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vue-tsc -b",
    "test": "vitest run --coverage",
    "type-check": "vue-tsc --noEmit",
    "test:watch": "vitest",
    "clean": "rm -rf coverage node_modules/.tmp dist",
    "lint": "eslint . && prettier --check src/",
    "format": "eslint . --fix && prettier --write src/"
  },
  "exports": {
    ".": "./src/index.ts",
    "./theme.css": "./src/theme/theme.css",
    "./vite": "./src/vite/index.ts"
  },
  "peerDependencies": {
    "vue": "^3.5.13",
    "@vueuse/core": "^15.0.0",
    "vue-i18n": "^11.4.16",
    "effect": "^4.0.4",
    "vite-imagetools": "^12.0.1"
  }
}
