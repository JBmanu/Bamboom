{
  "name": "player",
  "version": "0.2.3",
  "description": "Bamboom player frontend (Vue 3 + Vite)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run --coverage",
    "type-check": "vue-tsc --noEmit",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "lint": "eslint . && prettier --check src/",
    "format": "eslint . --fix && prettier --write src/"
  },
  "dependencies": {
    "@bamboom/common": "*",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  }
}
