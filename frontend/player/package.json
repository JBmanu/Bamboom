{
  "name": "player",
  "version": "0.3.0",
  "description": "Bamboom player frontend (Vue 3 + Vite)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run --coverage",
    "type-check": "vue-tsc --noEmit",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "lint": "eslint . && prettier --check src/",
    "format": "eslint . --fix && prettier --write src/"
  },
  "dependencies": {
    "@bamboom/common": "*",
    "@vueuse/core": "^15.0.0",
    "effect": "^4.0.4",
    "pinia": "^4.0.3",
    "vue": "^3.5.13",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.0.0"
  }
}
